{
    "name": "infrangible/m2-import-entity",
    "description": "Technical groundwork for imports of Magento records such as products or categories, including attributes, option values and related data.",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Import"
    ],
    "homepage": "https://www.infrangible.dev/modules/import-entity",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "fewedev/base": "~2.4.3",
        "infrangible/m2-core": "~5.0.5",
        "infrangible/m2-foundation": "~3.0.1",
        "infrangible/m2-import": "~2.0.0",
        "magento/framework": "~103.0.6",
        "magento/module-eav": "~102.1.0",
        "magento/module-import-export": "~101.0.0",
        "magento/module-store": "~101.1.0",
        "psr/log": "~2.0.0||~3.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\ImportEntity\\": "src"
        }
    }
}
